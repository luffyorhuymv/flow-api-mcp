CHROME_PROFILE_DIR=./data/chrome-profile
OUTPUT_DIR=./output
LOCALE=en
HEADLESS=true
USE_SYSTEM_CHROME=true
FLOW_URL=https://labs.google/fx/tools/flow
GENERATION_TIMEOUT_MS=180000
POLL_INTERVAL_MS=2000
ACTION_TIMEOUT_MS=30000
HTTP_HOST=127.0.0.1
HTTP_PORT=5555
# Set to require Bearer auth on /mcp (recommended when using Cloudflare Tunnel)
# HTTP_AUTH_TOKEN=your-secret-token-here
